{
    "name": "@cityvoice/server",
    "version": "0.2.0",
    "private": true,
    "type": "module",
    "dependencies": {
        "@cloudflare/workers-oauth-provider": "1.2.0",
        "@modelcontextprotocol/server": "2.1.0",
        "zod": "4"
    },
    "devDependencies": {
        "@modelcontextprotocol/client": "2.1.0",
        "@types/bun": "^1.4.2",
        "@types/node": "^26.6.3",
        "typescript": "^6",
        "wrangler": "4.143.0"
    },
    "scripts": {
        "dev": "bun --watch src/index.ts",
        "start": "bun src/index.ts",
        "test": "bun test",
        "typecheck": "tsc --noEmit",
        "worker:dev": "wrangler dev --port 8790",
        "db:migrate:local": "wrangler d1 migrations apply cityvoice --local",
        "db:seed:local": "bun scripts/seedSql.ts > .wrangler/seed.sql && wrangler d1 execute cityvoice --local --file .wrangler/seed.sql",
        "worker:dev:oauth": "wrangler dev --port 8790 --var AUTH_MODE:oauth --var PUBLIC_URL:http://localhost:8790",
        "smoke:oauth": "bun scripts/oauthSmoke.ts"
    }
}
