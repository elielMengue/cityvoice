{
    "$schema": "../node_modules/wrangler/config-schema.json",
    "name": "cityvoice",
    "main": "src/worker.ts",
    "compatibility_date": "2026-09-28",
    "compatibility_flags": ["nodejs_compat"],
    // Run next to the database rather than next to the caller: each tool call
    // makes several D1 queries, so this is what keeps us under 500 ms.
    "placement": { "mode": "smart" },
    "observability": { "enabled": true },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "cityvoice",
            // Local development uses its own SQLite file, never this database.
            "database_id": "9be5f911-cf06-4ed3-9134-e95d5df70b9b",
            "migrations_dir": "migrations",
        },
    ],
    // OAuth clients, grants and tokens (stored hashed by the library).
    "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "d28d8f73a8be480d9f1c75589a04fb38" }],
    // Local development: the demo authenticator is allowed here only.
    "vars": {
        "NODE_ENV": "development",
        "AUTH_MODE": "demo",
        "LOG_LEVEL": "info",
    },
    "env": {
        "production": {
            // Keep the plain name so the address stays cityvoice.<account>.workers.dev.
            "name": "cityvoice",
            "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "d28d8f73a8be480d9f1c75589a04fb38" }],
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "cityvoice",
                    "database_id": "9be5f911-cf06-4ed3-9134-e95d5df70b9b",
                    "migrations_dir": "migrations",
                },
            ],
            "vars": {
                "NODE_ENV": "production",
                "AUTH_MODE": "oauth",
                "PUBLIC_URL": "https://cityvoice.demop.workers.dev",
                "LOG_LEVEL": "info",
            },
        },
    },
}
