{
    "$schema": "../node_modules/wrangler/config-schema.json",
    "name": "cityvoice",
    "main": "src/worker.ts",
    "compatibility_date": "2026-09-28",
    "compatibility_flags": ["nodejs_compat"],
    // Run next to the database rather than next to the caller: each tool call
    // makes several D1 queries, so this is what keeps us under 500 ms.
    "placement": { "mode": "smart" },
    "observability": { "enabled": true },
    // Refreshes the mirror of San Francisco's real 311 requests.
    "triggers": { "crons": ["*/10 * * * *"] },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "cityvoice",
            // Local development uses its own SQLite file, never this database.
            "database_id": "9be5f911-cf06-4ed3-9134-e95d5df70b9b",
            "migrations_dir": "migrations",
        },
    ],
    // OAuth clients, grants and tokens (stored hashed by the library).
    "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "d28d8f73a8be480d9f1c75589a04fb38" }],
    // Per minute. Linking is two requests to /authorize, so 20 is plenty for
    // a person; a voice turn is one to three MCP calls.
    "ratelimits": [
        { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
        { "name": "MCP_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    ],
    // Local development: the demo authenticator is allowed here only.
    "vars": {
        "NODE_ENV": "development",
        "AUTH_MODE": "demo",
        "LOG_LEVEL": "info",
    },
    "env": {
        "production": {
            // Keep the plain name so the address stays cityvoice.<account>.workers.dev.
            "name": "cityvoice",
            "triggers": { "crons": ["*/10 * * * *"] },
            "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "d28d8f73a8be480d9f1c75589a04fb38" }],
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "cityvoice",
                    "database_id": "9be5f911-cf06-4ed3-9134-e95d5df70b9b",
                    "migrations_dir": "migrations",
                },
            ],
            "ratelimits": [
                { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
                { "name": "MCP_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
            ],
            "vars": {
                "NODE_ENV": "production",
                "AUTH_MODE": "oauth",
                "PUBLIC_URL": "https://cityvoice.demop.workers.dev",
                "LOG_LEVEL": "info",
                // Registered clients: the simulator (BaI2IsJ-KlbWExFT) and the
                // smoke test (k-Sulh3y7PuFJO71). To add one, deploy once with
                // this set to "true", register, then deploy again without it.
                "ALLOW_CLIENT_REGISTRATION": "false",
            },
        },
    },
}
