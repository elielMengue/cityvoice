{
    "$schema": "../node_modules/wrangler/config-schema.json",
    "name": "cityvoice-simulator",
    "main": "src/worker.ts",
    "compatibility_date": "2026-09-28",
    // The page, its script and its styles. Anything that is not a file here
    // (/api/*, /login, /callback) reaches the Worker.
    "assets": { "directory": "./public", "binding": "ASSETS" },
    "observability": { "enabled": true },
    // Open models on Cloudflare; runs remotely even in local development.
    "ai": { "binding": "AI" },
    // GEMINI_API_KEY is a secret: .env.local for `bun run dev`, and
    // `wrangler secret put GEMINI_API_KEY --env production` online.
    "vars": {
        "CITYVOICE_URL": "https://cityvoice.demop.workers.dev",
        // Public OAuth client registered with CityVoice for both redirect URIs
        // (localhost:8791 and the deployed simulator). Not a secret.
        "CLIENT_ID": "BaI2IsJ-KlbWExFT",
        // Tried in order: Workers AI first (fast), then Gemini (often busy on the free tier).
        "WORKERS_AI_MODELS": "@cf/meta/llama-4-scout-17b-16e-instruct,@cf/mistralai/mistral-small-3.1-24b-instruct",
        "GEMINI_MODELS": "gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-flash-latest",
    },
    "env": {
        "production": {
            "name": "cityvoice-simulator",
            "vars": {
                "CITYVOICE_URL": "https://cityvoice.demop.workers.dev",
                "CLIENT_ID": "BaI2IsJ-KlbWExFT",
                "WORKERS_AI_MODELS": "@cf/meta/llama-4-scout-17b-16e-instruct,@cf/mistralai/mistral-small-3.1-24b-instruct",
                "GEMINI_MODELS": "gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-flash-latest",
            },
        },
    },
}
